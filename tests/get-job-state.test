{
    NAME "Read the dedicated ML-1865 test job"
    OPERATION Get-Job-Attributes
    GROUP operation
    ATTR charset attributes-charset utf-8
    ATTR language attributes-natural-language en
    ATTR uri job-uri $uri
    ATTR keyword requested-attributes job-id,job-state,job-state-reasons,job-state-message,job-impressions-completed,job-media-sheets-completed,job-printer-uri,job-name
    STATUS successful-ok
    EXPECT job-state
}
